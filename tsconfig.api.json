{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "api",
    "src/types.ts",
    "src/lib/layoutGenerator.ts",
    "src/lib/calendar.ts",
    "src/lib/svgExport.ts",
    "src/lib/layering.ts",
    "src/data/orientation.ts",
    "src/data/templates.ts",
    "src/data/calendarDigits.ts"
  ]
}
